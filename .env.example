# Corporate Proxy Configuration (NEVER commit .env files with real credentials)
# Copy this to .env.corporate or .env.local and fill with your proxy details
# These variables are ONLY for corporate environments

# HTTP proxy URL with credentials
# Format: http://username:password@proxy-host:port
HTTP_PROXY=

# HTTPS proxy URL with credentials
HTTPS_PROXY=

# Comma-separated list of hosts that should NOT use the proxy
NO_PROXY=localhost,127.0.0.1,.googleapis.com,.google.com,.local

# --- API de IOL (InvertirOnline) — cotizaciones primarias, ver DESARROLLO.md ---
# El usuario/contraseña de IOL NUNCA van acá ni en ninguna variable de entorno: van en
# credentials/iol.json (gitignored), montado read-only por docker-compose.yml. Ver CREDENTIALS.md.

# Apaga sólo IOL sin apagar el resto de market_data (data912/analisistecnico).
IOL_ENABLED=true

# Tope de llamadas mensuales antes de dejar de pegarle a IOL y caer a data912. Colchón (~12%)
# bajo el límite bonificado real de IOL (25.000/mes).
IOL_LIMITE_MENSUAL=22000
