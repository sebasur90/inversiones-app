# Corporate Proxy Configuration (NEVER commit .env files with real credentials)
# Copy this to .env.corporate or .env.local and fill with your proxy details
# These variables are ONLY for corporate environments

# HTTP proxy URL with credentials
# Format: http://username:password@proxy-host:port
HTTP_PROXY=

# HTTPS proxy URL with credentials
HTTPS_PROXY=

# Comma-separated list of hosts that should NOT use the proxy
NO_PROXY=localhost,127.0.0.1,.googleapis.com,.google.com,.local

# --- API de IOL (InvertirOnline) — cotizaciones primarias, ver DESARROLLO.md ---
# El usuario/contraseña de IOL NUNCA van acá ni en ninguna variable de entorno: van en
# credentials/iol.json (gitignored), montado read-only por docker-compose.yml. Ver CREDENTIALS.md.

# Apaga sólo IOL sin apagar el resto de market_data (data912/analisistecnico).
IOL_ENABLED=true

# Tope de llamadas mensuales antes de dejar de pegarle a IOL y caer a data912. Colchón (~12%)
# bajo el límite bonificado real de IOL (25.000/mes).
IOL_LIMITE_MENSUAL=22000

# Tope de llamadas a IOL por corrida de sync — colchón adicional para que un solo sync (o una
# ráfaga de re-syncs durante la convergencia del backfill) no consuma el cupo del mes de golpe.
# Un sync en régimen gasta ~8; el pico con backfill pendiente es ~31. 0 = sin cota por corrida.
IOL_MAX_LLAMADAS_POR_SYNC=60

# --- Alertas de precio por Telegram ---
# Avisan de los cruces de stop-loss, precio objetivo y zona de compra de la watchlist, con la app
# cerrada. Por qué Telegram y no Web Push: la app se sirve por HTTP en la LAN, y los navegadores
# no permiten notificaciones ni service workers en orígenes que no son seguros (haría falta HTTPS).
#
# Cómo obtener los dos valores:
#   1. Hablale a @BotFather en Telegram, /newbot, y copiá el token que te da.
#   2. Mandale un mensaje a tu bot y abrí https://api.telegram.org/bot<TOKEN>/getUpdates
#      para ver tu chat id en `result[0].message.chat.id`.

# Interruptor general. En false no se manda nada (ni el mensaje de prueba).
ALERTAS_ENABLED=false

# Token del bot. NUNCA commitear esto con un valor real.
TELEGRAM_BOT_TOKEN=

# Chat al que se mandan los avisos (tu chat privado con el bot).
TELEGRAM_CHAT_ID=

# --- Jobs programados (traer datos y avisar sin abrir la app) ---
# El sync siempre fue pull desde el cliente: si nadie abre la PWA, no entra ningún dato y ninguna
# alerta puede dispararse. Prender esto sólo en el servidor, no en la máquina de desarrollo
# (gasta cupo de IOL).
#
# Son dos jobs:
#   - sync completo del Sheet, una vez por día después del cierre (SCHEDULER_HORA/MINUTO);
#   - refresco liviano de cotizaciones durante la rueda (REFRESCO_HORAS), que no lee el Sheet ni
#     escribe en el historial de Calidad de datos.
#
# Costo: cada corrida (sync o refresco) gasta ~10 llamadas a IOL. Un sync diario + 4 refrescos por
# día hábil son ~1.050 al mes contra el tope de 22.000: menos del 5%.
SCHEDULER_ENABLED=false

# Sync completo: hora local, lunes a viernes. El default es después del cierre del mercado.
SCHEDULER_HORA=18
SCHEDULER_MINUTO=30
SCHEDULER_TZ=America/Argentina/Buenos_Aires

# Refresco de precios: horas separadas por coma, lunes a viernes. El default cubre la rueda de
# contado (11 a 17) cada dos horas. Dejarlo VACÍO desactiva sólo este job.
REFRESCO_HORAS=11,13,15,17
REFRESCO_MINUTO=5

# --- Logs ---
# DEBUG | INFO | WARNING | ERROR. Sin esta variable el root logger de Python queda en WARNING y
# los `logger.info` de la app (resumen del sync, job programado, alertas) no se emiten nunca.
LOG_LEVEL=INFO
