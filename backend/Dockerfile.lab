# Imagen del laboratorio de estrategias: misma base que el backend + JupyterLab.
# El código (`app/`) y los notebooks (`lab/`) se montan como volúmenes en runtime (ver
# docker-compose.yml, servicio `lab`), no se copian acá.
FROM python:3.13-slim

WORKDIR /app

# Support corporate proxy via build args
ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG NO_PROXY=""

ENV http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    no_proxy=${NO_PROXY}

COPY requirements.txt requirements-lab.txt ./
RUN pip install --no-cache-dir -r requirements-lab.txt

ENV PYTHONPATH=/app

EXPOSE 8888

# `--ip=0.0.0.0` es para que el reenvío de puerto de Docker llegue a Jupyter DENTRO del contenedor;
# la restricción a loopback la impone el publish `127.0.0.1:8888:8888` de docker-compose.yml
# (servicio `lab`), NO este flag. Jupyter ejecuta código arbitrario como root con la DB de la
# cartera montada: si el puerto se publicara sin el prefijo 127.0.0.1 quedaría accesible desde toda
# la LAN sin token. El token se desactiva sólo porque el puerto no sale de la máquina.
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", \
     "--ServerApp.token=", "--ServerApp.password=", "--notebook-dir=/app/lab"]
